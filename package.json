{
  "name": "mercasimple",
  "version": "1.0.0",
  "description": "MercaSimple monorepo — shared tooling (ESLint, Prettier)",
  "private": true,
  "scripts": {
    "lint": "eslint \"{auth-service,catalog-service,orders-service,payments-service}/src/**/*.ts\"",
    "lint:auth": "eslint auth-service/src --ext .ts",
    "lint:catalog": "eslint catalog-service/src --ext .ts",
    "lint:orders": "eslint orders-service/src --ext .ts",
    "lint:payments": "eslint payments-service/src --ext .ts",
    "lint:fix": "eslint \"{auth-service,catalog-service,orders-service,payments-service}/src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^8.57.1",
    "typescript": "^5.4.5"
  }
}
